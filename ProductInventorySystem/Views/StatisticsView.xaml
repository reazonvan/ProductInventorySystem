<UserControl x:Class="ProductInventorySystem.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProductInventorySystem.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок модуля -->
        <TextBlock Grid.Row="0" 
                   Text="Статистика товаров" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <!-- Общая статистика -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#BDC3C7" 
                BorderThickness="2" 
                CornerRadius="5" 
                Padding="20" 
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Общая статистика" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Общее количество товаров -->
                    <Border Grid.Column="0" 
                            Background="#3498DB" 
                            CornerRadius="5" 
                            Padding="15" 
                            Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Общее количество товаров" 
                                       Foreground="White" 
                                       FontSize="12" 
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtTotalProducts" 
                                       Text="0" 
                                       Foreground="White" 
                                       FontSize="28" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Средняя цена -->
                    <Border Grid.Column="1" 
                            Background="#27AE60" 
                            CornerRadius="5" 
                            Padding="15" 
                            Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Средняя цена" 
                                       Foreground="White" 
                                       FontSize="12"/>
                            <TextBlock x:Name="txtAveragePrice" 
                                       Text="0 руб." 
                                       Foreground="White" 
                                       FontSize="28" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Общая сумма -->
                    <Border Grid.Column="2" 
                            Background="#E74C3C" 
                            CornerRadius="5" 
                            Padding="15">
                        <StackPanel>
                            <TextBlock Text="Общая стоимость" 
                                       Foreground="White" 
                                       FontSize="12"/>
                            <TextBlock x:Name="txtTotalValue" 
                                       Text="0 руб." 
                                       Foreground="White" 
                                       FontSize="28" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Статистика по категориям -->
        <Border Grid.Row="2" 
                Background="White" 
                BorderBrush="#BDC3C7" 
                BorderThickness="2" 
                CornerRadius="5" 
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Статистика по категориям" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Margin="0,0,0,15"/>

                <!-- Выбор категории -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Выберите категорию:" 
                               VerticalAlignment="Center" 
                               Margin="0,0,10,0"/>
                    <ComboBox x:Name="cmbCategories" 
                              Width="200" 
                              Height="30"
                              SelectionChanged="cmbCategories_SelectionChanged"/>
                    <Button Content="Обновить" 
                            Width="100" 
                            Height="30" 
                            Margin="10,0,0,0"
                            Background="#3498DB"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnRefresh_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#3498DB"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2980B9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Информация по категории -->
                <Grid Grid.Row="2" x:Name="categoryStatsPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" 
                            Background="#9B59B6" 
                            CornerRadius="5" 
                            Padding="15" 
                            Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Количество в категории" 
                                       Foreground="White" 
                                       FontSize="12" 
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtCategoryProducts" 
                                       Text="0" 
                                       Foreground="White" 
                                       FontSize="28" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" 
                            Background="#F39C12" 
                            CornerRadius="5" 
                            Padding="15" 
                            Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Средняя цена в категории" 
                                       Foreground="White" 
                                       FontSize="12" 
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtCategoryAveragePrice" 
                                       Text="0 руб." 
                                       Foreground="White" 
                                       FontSize="28" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" 
                            Background="#16A085" 
                            CornerRadius="5" 
                            Padding="15">
                        <StackPanel>
                            <TextBlock Text="Стоимость в категории" 
                                       Foreground="White" 
                                       FontSize="12" 
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtCategoryTotalValue" 
                                       Text="0 руб." 
                                       Foreground="White" 
                                       FontSize="28" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>


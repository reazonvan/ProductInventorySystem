<UserControl x:Class="ProductInventorySystem.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProductInventorySystem.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок модуля -->
        <TextBlock Grid.Row="0" 
                   Text="Поиск товаров" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <!-- Панель поиска -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#BDC3C7" 
                BorderThickness="2" 
                CornerRadius="5" 
                Padding="20" 
                Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Поиск по названию -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Поиск по названию:" 
                               VerticalAlignment="Center" 
                               Width="150" 
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="txtSearchName" 
                             Width="300" 
                             Height="35" 
                             Padding="5"
                             FontSize="14"
                             VerticalContentAlignment="Center"/>
                    <Button Content="Найти" 
                            Width="100" 
                            Height="35" 
                            Margin="10,0,0,0"
                            Background="#3498DB"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnSearchByName_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#3498DB"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2980B9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Поиск по категории -->
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBlock Text="Поиск по категории:" 
                               VerticalAlignment="Center" 
                               Width="150" 
                               FontWeight="SemiBold"/>
                    <ComboBox x:Name="cmbSearchCategory" 
                              Width="300" 
                              Height="35"
                              FontSize="14"
                              VerticalContentAlignment="Center"/>
                    <Button Content="Найти" 
                            Width="100" 
                            Height="35" 
                            Margin="10,0,0,0"
                            Background="#27AE60"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnSearchByCategory_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#27AE60"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#229954"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Сбросить" 
                            Width="100" 
                            Height="35" 
                            Margin="10,0,0,0"
                            Background="#95A5A6"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnReset_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#95A5A6"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#7F8C8D"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Результаты поиска -->
        <Border Grid.Row="2" 
                Background="White" 
                BorderBrush="#BDC3C7" 
                BorderThickness="2" 
                CornerRadius="5" 
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Результаты поиска:" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtResultCount" 
                               Text="(0 товаров)" 
                               FontSize="14" 
                               Foreground="#7F8C8D" 
                               Margin="10,0,0,0" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <DataGrid Grid.Row="1" 
                          x:Name="dgSearchResults" 
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="All"
                          AlternatingRowBackground="#F0F0F0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ProductID}" Width="50"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="150"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:C}}" Width="100"/>
                        <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

